{
  "name": "oracle-fate-card-game",
  "version": "1.0.0",
  "private": true,
  "description": "Oracle — a mythic turn-based tarot board game",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "package:win": "pnpm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "typescript": "^5.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.oracle.fatecardgame",
    "productName": "Oracle",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": ["portable"] }
  }
}
